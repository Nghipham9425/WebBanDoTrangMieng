@startuml
title Sequence Diagram - Đổi mật khẩu

actor "User" as user
participant "View" as view
participant "UserController" as controller
database "DB" as db

user -> view : 1: nhập mật khẩu cũ/mới
view -> controller : 2: ChangePassword(currentPwd, newPwd, confirmPwd)

controller -> controller : 3: Kiểm tra Session["UserId"]
controller -> db : 4: Users.Find(userId)
db -> controller : 5: return User object
controller -> controller : 6: Kiểm tra user.Password == currentPassword

alt Thành công
    controller -> controller : 7: user.Password = newPassword
    controller -> db : 8: db.SaveChanges()
    db -> controller : 9: success
    controller -> view : 10: JSON {success: true, "Đổi mật khẩu thành công"}
    view -> user : 11: hiển thị thành công
else Thất bại
    controller -> view : 12: JSON {success: false, message}
    view -> user : 13: hiển thị lỗi
end

@enduml 